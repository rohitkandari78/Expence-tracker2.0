{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/dashboard", "destination": "/frontend/dashboard/index.html" },
    { "source": "/dashboard/dashboard", "destination": "/frontend/dashboard/index.html" },
    { "source": "/dashboard/dashboard.html", "destination": "/frontend/dashboard/index.html" },
    { "source": "/dashboard/(.*)", "destination": "/frontend/dashboard/$1" },
    { "source": "/login", "destination": "/frontend/login/login.html" },
    { "source": "/login/(.*)", "destination": "/frontend/login/$1" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/api/(.*)", "destination": "/frontend/api/$1" }
  ]
}
